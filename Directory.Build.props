<Project>

  <!-- Luat chung cho moi project .NET trong repo. Xem docs/ARCHITECTURE-SPINE.md (AD-1). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NeutralLanguage>vi-VN</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- AD-2: ValidateScopes/ValidateOnBuild bat o MOI moi truong, ke ca production.
       Hai co bat trong code (PlatformHost), day chi la nhac lai bang hang so. -->
  <PropertyGroup>
    <StaxiValidateScopesAlways>true</StaxiValidateScopesAlways>
  </PropertyGroup>

</Project>
