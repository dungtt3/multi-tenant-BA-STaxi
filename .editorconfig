root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,html,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,csx}]
# UTF-8 KHONG BOM - repo nay khong ke thua luat BOM cua ba_staxi_webadmin
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_require_accessibility_modifiers = always:warning
csharp_style_var_when_type_is_apparent = true:suggestion

[*.{sln,slnx,csproj,props,targets}]
indent_size = 2

[*.cs]
# CA1848 - LoggerMessage delegate cho MOI cho ghi log. Ha xuong goi y co chu y:
# nen tang moi co vai cho ghi log va deu o duong nguoi hoac duong loi, chua do duoc cai gia thuc.
# Xem lai khi co so do hieu nang thuc te.
dotnet_diagnostic.CA1848.severity = suggestion

[tests/**/*.cs]
# Ten bai test dung gach duoi de doc duoc dang "TinhHuong_KetQua" - quy uoc cua xUnit, khong phai API cong khai.
dotnet_diagnostic.CA1707.severity = none
